direction: right

title: The numbers that name a row and a column {
  near: top-center
  shape: text
  style.font-size: 24
}

classes: {
  data: {style.fill: "#3d3d3d"}
  row: {style.fill: "#2d2d4a"}
  column: {style.fill: "#2d4a2d"}
  stream: {style.fill: "#4a4a2d"}
}

rows: A row on the page {
  style.fill: "#1a1a2a"

  row: "csv.Row\none per drawn line, built fresh every render" {class: row}

  numbers: The three numbers {
    shape: sql_table
    class: data
    row_id: position in the file, from enum
    row_number: what the gutter shows
    buffer_line: index into layout.lines
  }

  lookups: "rows_by_id\nrows_by_number\nrows_by_line" {class: row}

  row -> numbers
  row -> lookups
}

cols: A column {
  style.fill: "#1a1a2a"

  column: "csv.Column\nlives in state.columns for the life of the buffer" {class: column}

  col_numbers: The two numbers {
    shape: sql_table
    class: data
    column_id: 0-based, in the file
    column_number: 1-based, among the drawn columns
  }

  drawn: "Where it is drawn\nlayout.columns[n] and layout.ranges[n]" {class: column}

  column -> col_numbers
  column -> drawn
}

stream: Where a column sits in the xan stream {
  style.fill: "#1a1a2a"

  carried: "pipeline.carried_columns\nselect <carried> | enum -c id" {class: stream}
  positions: "position_by_column_id\none position per column, for the whole run" {class: stream}
  who: "What is carried\nthe drawn columns, plus any a sort or filter names" {class: data}

  carried -> positions
  positions -> who
}
