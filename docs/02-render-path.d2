direction: down

title: The render path {
  near: top-center
  shape: text
  style.font-size: 24
}

classes: {
  build: {style.fill: "#4a4a2d"}
  draw: {style.fill: "#2d4a2d"}
  external: {style.fill: "#4a2d2d"}
}

render: "buffer.render\nclears the selection, snapshots the columns" {class: draw}
commands: "commands.render\none xan process" {class: build}
pipeline: "pipeline.build\nselect, enum, filter, sort, slice, view" {class: build}
expression: "expression.lua\nfilter and map bodies, as moonblade" {class: build}
query: "query.run\nspawns xan, buffers stdout" {class: build}

xan: xan {
  class: external
  shape: cloud
}

parse: "layout.parse\nstrips row id column and stores it" {class: draw}
lines: "nvim_buf_set_lines\nwrite pretty printed csv table" {class: draw}
redraw: "overlay.redraw\nmarked rows, marked columns, the selection" {class: draw}
restore: active_cell.restore {class: draw}
highlight: "highlight.lua\ncolors borders, header, numbers, dates" {class: draw}
gutter: "statuscolumn.lua\nrow number in the gutter" {class: draw}

render -> commands
commands -> pipeline
pipeline -> expression
commands -> query
query -> xan
xan -> parse: the drawn table
parse -> lines
lines -> redraw
redraw -> restore
lines -> highlight: on every screen redraw
lines -> gutter: on every screen redraw
