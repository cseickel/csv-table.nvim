direction: down

title: pipeline.build, stage by stage {
  near: top-center
  shape: text
  style.font-size: 24
}

example: "Worked through a,b,c, with b hidden and c sorted descending\nEvery stage names its columns by position" {style.fill: "#1a1a2a"}

classes: {
  stage: {style.fill: "#4a4a2d"}
  shape_after: {style.fill: "#2d2d4a"}
  post: {style.fill: "#2d4a2d"}
}

source: "The file\na,b,c" {class: shape_after}
select: "select 0,2\nthe carried columns, by file position" {class: stage}
enum: "enum -c id\nprepends the row id" {class: stage}
fixed: "id,a,c\nthe shape is now fixed" {class: shape_after}
filter: "filter <expression>\nthe effective filters ANDed, as moonblade" {class: stage}
narrowing: "count, stats, frequency\nopen their own pipelines" {class: post}
sort: "sort -s 2 -R\none stage per key, least significant first" {class: stage}
slice: "slice -s 0 -l 1000\nthe page" {class: stage}
display: "select -e ...\nwidths, formats and header text" {class: stage}
after_display: "id,a,c ▼" {class: shape_after}
view: "view -t table ...\ndraws each column at its own width, capped by --cols" {class: stage}

# Padded with U+00A0. d2 writes no xml:space, so SVG collapses a run of ordinary
# spaces and the cells come out narrower than the borders above them.
drawn: "┌────┬────┬─────┐\n│ id │ a  │ c ▼ │\n├────┼────┼─────┤\n│  0 │ 10 │   3 │\n│  2 │ 30 │   2 │\n└────┴────┴─────┘" {
  class: shape_after
  style.font: mono
}

parse: "reader.parse.page\nstrips the row id cell and files each row under its id" {class: post}

source -> select
select -> enum
enum -> fixed
fixed -> filter
filter -> sort
sort -> slice
slice -> display
display -> after_display
after_display -> view
view -> drawn
drawn -> parse
filter -> narrowing: the narrowing stages
