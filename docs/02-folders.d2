direction: down

title: What each folder requires {
  near: top-center
  shape: text
  style.font-size: 24
}

rule: "An arrow points from a folder to one it requires.\nA function that changes an object lives in that object's folder." {
  shape: text
  style.font-size: 18
}

classes: {
  entry: {style.fill: "#3d2d4a"}
  data: {style.fill: "#2d2d4a"}
  run: {style.fill: "#4a4a2d"}
  draw: {style.fill: "#2d4a2d"}
  ui: {style.fill: "#3d3d3d"}
}

init: "init.lua\nsetup, the BufReadCmd, the CsvTable command, the statusline" {class: entry}
keymaps: "keymaps.lua\nevery key and the action it names" {class: entry}
actions: "actions/\na registry each module beside it adds to when it loads" {class: entry}

popup: "popup/\nfloats, pickers, panels and dialogs drawn over the table" {class: ui}
buffer: "buffer/\ncsv.Buffer: the query, the page, one csv.View per window\nrender, color, the gutter, the hidden cursor" {class: draw}
view: "view/\ncsv.View: the active cell, the selection, the viewport, yank\nkeeps nvim's visual region on the selected block" {class: draw}

file: "file/\ncsv.File: opens a spreadsheet and reads its columns and formats" {class: data}
query: "query/\ncsv.Query: filters, sort, marks, columns, paging, the row count" {class: data}
reader: "reader/\nbuilds and runs the xan commands\nno other folder names xan" {class: run}
page: "page/\ncsv.Page: the drawn table and where every cell sits" {class: data}
utils: "utils/\ntext widths, json indenting, the error notifier,\nwhich nvim modes are visual" {class: ui}

init -> actions
init -> buffer
init -> keymaps
init -> query
init -> utils

actions -> buffer
actions -> popup
popup -> actions: the help panel runs one
popup -> keymaps
popup -> utils

buffer -> file
buffer -> query
buffer -> page
buffer -> reader
buffer -> utils
buffer -> view

view -> page
view -> utils

file -> reader
file -> utils
reader -> page
reader -> utils
page -> utils
