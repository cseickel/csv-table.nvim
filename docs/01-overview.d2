direction: down

title: Modules, and what each one requires {
  near: top-center
  shape: text
  style.font-size: 24
}

classes: {
  entry: {style.fill: "#3d2d4a"}
  state: {style.fill: "#2d2d4a"}
  build: {style.fill: "#4a4a2d"}
  draw: {style.fill: "#2d4a2d"}
  ui: {style.fill: "#3d3d3d"}
  external: {style.fill: "#4a2d2d"}
}

entry: Entry {
  style.fill: "#1a1a2a"
  init: "init.lua\n· setup and the BufReadCmd\n· the CsvTable command\n· the statusline" {class: entry}
  keymaps: "keymaps.lua\n· every key and its action\n· resolved against the config" {class: entry}
  actions: "actions/\n· every action a key runs\n· one registry, by name" {class: entry}
}

state: View state {
  style.fill: "#1a1a2a"
  state_mod: "state.lua\n· csv.State, one per buffer\n· sort, filters, marks, paging" {class: state}
  columns: "columns.lua\n· csv.Column\n· display order and hiding" {class: state}
  format: "format.lua\n· csv.Format, one per column\n· kind, decimals, width, align" {class: state}
  selection: "selection.lua\n· csv.Selection\n· anchor, head, kind, bounds" {class: state}
  source: "source.lua\n· csv.Source\n· columns, formats, sheets" {class: state}
  state_mod -> columns
  state_mod -> format
  format -> columns
}

build: Building the xan command {
  style.fill: "#1a1a2a"
  commands: "commands.lua\n· every argv the plugin runs\n· render, count, stats, yank" {class: build}
  pipeline: "pipeline.lua\n· the stages of xan run\n· select, enum, filter, sort" {class: build}
  expression: "expression.lua\n· the moonblade xan takes\n· filters, printf, padding" {class: build}
  query: "query.lua\n· spawns xan, decodes json\n· reports every failure" {class: build}
  commands -> pipeline -> expression
  query -> commands
}

draw: Drawing the table {
  style.fill: "#1a1a2a"
  buffer: "buffer.lua\n· csv.Buffer, one per buffer\n· attach, render, open_sheet" {class: draw}
  layout: "layout.lua\n· csv.Layout, from xan view\n· rows, columns, cell ranges" {class: draw}
  movement: "movement.lua\n· moves the cell and the head\n· follows nvim's own motions" {class: draw}
  active_cell: "active_cell.lua\n· the cell the user is on\n· hides and parks the cursor" {class: draw}
  overlay: "overlay.lua\n· extmarks for the marks\n· and for the selection" {class: draw}
  highlight: "highlight.lua\n· defines every group\n· colors borders, header, cells" {class: draw}
  statuscolumn: "statuscolumn.lua\n· the row number in the gutter" {class: draw}
  buffer -> layout
  buffer -> movement
  buffer -> overlay
  buffer -> statuscolumn
  movement -> active_cell
  active_cell -> layout
  highlight -> buffer
}

ui: Floats {
  style.fill: "#1a1a2a"
  inspect: "inspect.lua\n· values read from the file\n· cell, row, yank" {class: ui}
  dialog: "dialog.lua\n· the filter dialog\n· the sheet list" {class: ui}
  panel: "panel.lua\n· help, file info, stats" {class: ui}
  picker: "picker.lua\n· a list, via vim.ui.select" {class: ui}
  window: "window.lua\n· a centered float" {class: ui}
  json: "json.lua\n· lays out a json cell" {class: ui}
  inspect -> window
  inspect -> picker
  inspect -> json
  dialog -> window
}

xan: xan {
  class: external
  shape: cloud
}

entry.init -> entry.keymaps
entry.init -> entry.actions
entry.init -> draw.buffer
entry.init -> draw.highlight

entry.actions -> state.state_mod
entry.actions -> draw.buffer
entry.actions -> draw.movement
entry.actions -> ui.inspect

state.selection -> draw.layout
state.source -> build.query
build.commands -> state.state_mod
build.query -> xan: spawns

draw.buffer -> state.source
draw.buffer -> build.commands
draw.movement -> state.selection

ui.inspect -> build.query
ui.panel -> build.query
