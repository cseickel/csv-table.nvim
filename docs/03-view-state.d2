direction: right

title: The state of a table buffer {
  near: top-center
  shape: text
  style.font-size: 24
}

classes: {
  state: {style.fill: "#2d2d4a"}
  data: {style.fill: "#3d3d3d"}
}

state: "state.lua\none csv.State per buffer" {class: state}

fields: csv.State {
  shape: sql_table
  class: data
  columns: every source column, hidden ones among them
  rowid_column: column_id -1
  filters: ANDed
  sort_keys: most significant first
  marked: row ids
  marked_columns: column ids
  formats: by column id
  selection: anchor, head, kind
  "page, limit": which slice of rows
}

columns: "columns.lua\nname, label, column_id, hidden, and which are drawn" {class: state}
format: "format.lua\ntype, width, alignment, printf spec" {class: state}
selection: "selection.lua\nbounds from the anchor, the head and the kind" {class: state}

state -> fields
state -> columns: identity, and which are drawn
state -> format: how each one reads
state -> selection: which cells are picked
